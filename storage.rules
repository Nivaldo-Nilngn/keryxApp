rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isPrimaryAdmin() {
      return signedIn() && (
        ('email' in request.auth.token && request.auth.token.email != null && request.auth.token.email.lower() == 'nivaldo.nilngn@gmail.com') ||
        request.auth.uid == 'I5v6l4CDUQRaliO9upJrE36QEHx1'
      );
    }

    // Arquivos públicos (assets compartilhados pela administração)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isPrimaryAdmin();
    }

    // Arquivos privados de usuários (ex: fotos de perfil, backups exportados)
    // Limite máximo de 10MB por arquivo
    match /users/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isPrimaryAdmin();
      allow write: if isOwner(userId)
                   && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isOwner(userId) || isPrimaryAdmin();
    }

    // Negação padrão estrita para qualquer outro caminho
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

